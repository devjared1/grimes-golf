<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The relay for online play: lobbies with a 5-character code, forwarding messages between the host's PC and its
    friends' PCs. It never reads the game's messages. Deliberately standalone (no project references) and on .NET 10,
    since it's the one piece that faces the internet.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SquareGspro.Relay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SquareGspro.Online.Tests" />
  </ItemGroup>

</Project>
