<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Windows target so the WinRT Bluetooth APIs (via GrimesGolf.Bluetooth) are available. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!--
      Every other platform (the iPad) builds as plain .NET: see MonitorLinks.cs.
      GodotTargetPlatform comes from the Godot SDK: the platform being exported for, or else the PC doing the build.
      (Keep this as "!= windows": the Godot editor deletes a TargetFramework with an "== platform" condition.)
    -->
    <TargetFramework Condition=" '$(GodotTargetPlatform)' != 'windows' ">net8.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GrimesGolf.Game</RootNamespace>
  </PropertyGroup>

  <!--
    GG_BLUETOOTH: this build has Bluetooth launch monitors, through GrimesGolf.Bluetooth: WinRT on Windows, and
    CoreBluetooth on the iPad (GG_IOS), where it calls a native library that tools/ios-export.sh links into the
    game's library, so the platform invoke to "__Internal" is made direct (resolved at link time, not looked up).
  -->
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'windows' Or '$(GodotTargetPlatform)' == 'ios' ">
    <DefineConstants>$(DefineConstants);GG_BLUETOOTH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(GodotTargetPlatform)' == 'ios' ">
    <DefineConstants>$(DefineConstants);GG_IOS</DefineConstants>
  </PropertyGroup>
  <!--
    The native library is linked into the game's own library, which Godot builds for the iPad and for each simulator:
    GG_BLE_LIBS (set by tools/ios-export.sh) is the folder tools/ios-native.sh made, with one folder per runtime.
    Without it the link fails, naming the missing gg_ble_* functions.
  -->
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'ios' ">
    <DirectPInvoke Include="__Internal" />
  </ItemGroup>
  <ItemGroup Condition=" '$(GodotTargetPlatform)' == 'ios' And '$(GG_BLE_LIBS)' != '' ">
    <NativeLibrary Include="$(GG_BLE_LIBS)/$(RuntimeIdentifier)/libggble.a" />
    <LinkerArg Include="-framework CoreBluetooth" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrimesGolf.Core\GrimesGolf.Core.csproj" />
    <ProjectReference Include="..\GrimesGolf.Bluetooth\GrimesGolf.Bluetooth.csproj" Condition=" '$(GodotTargetPlatform)' == 'windows' Or '$(GodotTargetPlatform)' == 'ios' " />
    <ProjectReference Include="..\GrimesGolf.Online\GrimesGolf.Online.csproj" />
  </ItemGroup>

</Project>
