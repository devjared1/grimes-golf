; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Grimes Golf"
config/version="0.9.7"
run/main_scene="res://Main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Square Range 3D"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/icons/grimes_golf_icon.png"
boot_splash/bg_color=Color(0.0235294, 0.0313726, 0.0352941, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/stretch_mode=4
boot_splash/minimum_display_time=2000

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode.template=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="GrimesGolf.Godot"

[rendering]

anti_aliasing/quality/msaa_3d=2
