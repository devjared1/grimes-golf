<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: records the monitor's Bluetooth packets while another simulator (GSPro) plays the shots, and compares
       our physics with that simulator's numbers. Not shipped with the game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrimesGolf.Core\GrimesGolf.Core.csproj" />
    <ProjectReference Include="..\GrimesGolf.Bluetooth\GrimesGolf.Bluetooth.csproj" />
  </ItemGroup>

</Project>
