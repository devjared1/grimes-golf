<Project Sdk="Godot.NET.Sdk/4.7.2">

  <PropertyGroup>
    <!-- Windows target so the WinRT Bluetooth APIs (via SquareGspro.Bluetooth) are available. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SquareGspro.Range3D</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SquareGspro.Core\SquareGspro.Core.csproj" />
    <ProjectReference Include="..\SquareGspro.Bluetooth\SquareGspro.Bluetooth.csproj" />
  </ItemGroup>

</Project>
